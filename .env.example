N8N_API_URL=https://your-n8n-url
N8N_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
N8N_WEBHOOK_URL=https://your-n8n-url/webhook/oluwaseyi-homes-lead
N8N_WEBHOOK_SECRET=
# Webhook that receives owner listing submissions with photos (multipart)
N8N_LISTING_WEBHOOK_URL=

# Header name set on the n8n Header Auth credential
N8N_WEBHOOK_HEADER=x-webhook-secret

# Paystack, for the property listing fee. The public key is used in the browser; the secret key stays on the server.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Supabase: database, dashboard login and file storage.
# The URL and anon key are used in the browser; the service role key stays on the server and in n8n.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the website, used for links in emails. Leave empty when running locally.
SITE_URL=
# Any long random text. Mixed into the daily visitor mark so visits cannot be linked across days. Optional.
TRACK_SALT=
# Private business details. Keep them here, never in the code.
# The WhatsApp number the website shows and links to: digits with country code, for example 2348012345678.
NEXT_PUBLIC_WHATSAPP=
# Optional: how the number is displayed (otherwise it is formatted for you).
NEXT_PUBLIC_WHATSAPP_LABEL=
# The Google Sheet that receives every enquiry (shown as a link in the dashboard sidebar).
LEAD_SHEET_URL=
# The three below are only used by scripts/sanitize-workflow.mjs, to blank them out of the n8n export.
LEAD_SHEET_ID=
TEAM_EMAIL=
LIVE_SITE_URL=
# Cloudflare Turnstile (free CAPTCHA) for the enquiry form. Create a widget at dash.cloudflare.com -> Turnstile,
# add your domain, then paste the site key and secret key. Leave both empty to run without a CAPTCHA.
# For local testing Cloudflare publishes dummy keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Developer machines only (ignored in production): send Paystack calls to a test stand-in instead of Paystack.
PAYSTACK_API_URL=
